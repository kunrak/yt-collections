# Server
PORT=3000
BASE_URL=http://localhost:3000
SESSION_SECRET=replace-with-a-long-random-string

# Neon / Postgres (optional but recommended for persistent data on Render)
# Example: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=

# Google OAuth (Google Cloud Console → APIs & Services → Credentials → OAuth client)
# Authorized redirect URI: {BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Set in production when served over HTTPS
# NODE_ENV=production
